    <section class="py-5">
        <div class="container">

            <article class="bg-primary-100 p-3 lg:p-6 bg-gradient-1 rounded my-6 bg-size-cover" style="background-image: url(/assets/images/banners/office.png);">
                <div class="d-flex justify-content-between">

                    <div class="p-5 max-w-100">
                        <h2 class="mb-4 lg:text-3xl">An easy way to send <br> requests to all suppliers</h2>
                        <p class="mb-5 text-lg text-secondary">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt.</p>
                    </div>

                    <article class="card lg:col-4 shadow">
                        <form class="card-body">
                            <h5 class="mb-4">Send quote to suppliers</h5>
                            <div class="mb-4">
                                <input type="text" class="form-control" placeholder="What item you need?">
                            </div>
                            <div class="mb-4">
                                <textarea class="form-control min-h-20" placeholder="Type more details" rows="3"></textarea>
                            </div>
                            <div class="mb-4 d-flex gap-2" style="max-width: 250px;">
                                <input type="number" class=" me-2 form-control" placeholder="Qty">
                                <select class="form-select">
                                    <option value="">Litres</option>
                                    <option value="">Kgs</option>
                                </select>
                            </div>
                            <button class="btn btn-primary"> Send inquiry </button>
                        </form>
                    </article>

                </div>
            </article>

        </div> <!-- container .//  -->
    </section>
    <!-- ============== SECTION BANNER END// ============== -->
{{ end }}