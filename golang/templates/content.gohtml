{{ define "content" }}

    <!-- ================ SECTION INTRO ================ -->
    <section class="mb-5 mt-5">
        <div class="container">
            <main class="card p-3">
                <div class="row gap-x-3">
                    <aside class="lg:w-65">
                        <nav class="nav nav-col max-lg:hidden">
                            <a class="nav-link" href="#">
                                <img src="/assets/images/icons-product/laptop.svg" width="20" height="20" alt="">
                                Electronics
                            </a>
                            <a class="nav-link" href="#">
                                <img src="/assets/images/icons-product/tshirt.svg" width="20" height="20" alt="">
                                Clothes and wear
                            </a>
                            <a class="nav-link" href="#">
                                <img src="/assets/images/icons-product/sofa.svg" width="20" height="20" alt="">
                                Home interiors
                            </a>
                            <a class="nav-link" href="#">
                                <img src="/assets/images/icons-product/book.svg" width="20" height="20" alt="">
                                Books & magazines
                            </a>
                            <a class="nav-link" href="#">
                                <img src="/assets/images/icons-product/painting.svg" width="20" height="20" alt="">
                                Tools, equipments
                            </a>
                            <a class="nav-link" href="#">
                                <img src="/assets/images/icons-product/ball.svg" width="20" height="20" alt="">
                                Sports and outdoor
                            </a>
                            <a class="nav-link" href="#">
                                <img src="/assets/images/icons-product/fish.svg" width="20" height="20" alt="">
                                Animal and pets
                            </a>
                            <a class="nav-link" href="#">
                                <img src="/assets/images/icons-product/toy.svg" width="20" height="20" alt="">
                                Toys for Kids
                            </a>
                            <a class="nav-link" href="#">
                                <img src="/assets/images/icons-product/more.svg" width="20" height="20" alt="">
                                More category
                            </a>
                        </nav>
                    </aside>
                    <div class="lg:col">
                        <!-- ===== banners =====  -->
                        <div class="row gap-3">
                            <div class="md:col-9">
                                <!-- banner main -->
                                <article class="bg-primary-200 relative rounded overflow-hidden">
                                    <div class="absolute top-10 left-10">
                                        <h2 class="mb-5 max-sm:text-lg"> <span class="text-primary">New trending</span> <br> Electronic items</h2>
                                        <a href="#" class="btn btn-neutral btn-lg">Learn more</a>
                                    </div>
                                    <img src="/assets/images/banners/main-phone.png" alt="Ecommerce banner" class="lg:h-90 w-full  rounded">
                                </article>
                                <!-- banner main end.// -->
                            </div>
                            <div class="md:col-3">
                                <!-- banner small -->
                                <article class="rounded overflow-hidden bg-dark h-full bg-position-center bg-size-cover" style="background-image: url(/assets/images/banners/man.png);">
                                    <div class="bg-alpha-6 py-10 text-white text-center d-flex flex-col justify-content-between h-full">
                                        <h5 class="text-xl mb-5">Get US $10 off <br> for first order</h5>
                                        <div>
                                            <a href="" class="btn btn-outline border-white rounded-full">Get offer</a>
                                        </div>
                                    </div>
                                </article>
                                <!-- banner small end.// -->
                            </div>
                        </div> <!-- row.// -->
                        <!-- ===== banners =====  -->
                    </div>
                    <!-- col.// -->
                </div>
            </main>
        </div> <!-- container end.// -->
    </section>
    <!-- ================ SECTION INTRO END.// ================ -->

    <!-- ================ SECTION DEAL================ -->
    <section class="pb-5">
        <div class="container">
            <div class="card overflow-hidden">
                <div class="md:d-flex gap-x-0">
                    <aside  class="lg:w-70 flex-shrink-0 max-lg:border-bottom">
                        <div class="p-6">
                            <header class="mb-5">
                                <h4>Deals and offers</h4>
                                <p class="text-secondary">Electronics & Gadgets</p>
                            </header><!-- sect-heading -->
                            <div class="timer mb-5">
                                <div> <span class="num">04</span> <small>Days</small></div>
                                <div> <span class="num">12</span> <small>Hours</small></div>
                                <div> <span class="num">58</span> <small>Min</small></div>
                                <div> <span class="num">02</span> <small>Sec</small></div>
                            </div>
                        </div>
                    </aside> <!-- col.// -->
                    <div class="row gap-cols-0">
                        <div class="md:col sm:col-4 col-6 border-left">
                            <figure class="p-2">
                                <a href="#" class="d-block"> <img class="rounded" src="/assets/images/product-tech/1.png"> </a>
                                <div class="px-2 py-3 text-center">
                                    <p class="mb-2"><a href="#" class="text-secondary">The Product name </a></p>
                                    <span class="bg-red-100 text-red px-3 py-1 d-inline-block rounded-full"> -20% </span>
                                </div>
                            </figure>
                        </div> <!-- col.// -->
                        <div class="md:col sm:col-4 col-6 border-left">
                            <figure class="p-2">
                                <a href="#" class="d-block"> <img class="rounded" src="/assets/images/product-tech/2.png"> </a>
                                <div class="px-2 py-3 text-center">
                                    <p class="mb-2"><a href="#" class="text-secondary">The Product name </a></p>
                                    <span class="bg-red-100 text-red px-3 py-1 d-inline-block rounded-full"> -5% </span>
                                </div>
                            </figure>
                        </div> <!-- col.// -->
                        <div class="md:col sm:col-4 col-6 border-left">
                            <figure class="p-2">
                                <a href="#" class="d-block"> <img class="rounded" src="/assets/images/product-tech/3.png"> </a>
                                <div class="px-2 py-3 text-center">
                                    <p class="mb-2"><a href="#" class="text-secondary">The Product name </a></p>
                                    <span class="bg-red-100 text-red px-3 py-1 d-inline-block rounded-full"> -7% </span>
                                </div>
                            </figure>
                        </div> <!-- col.// -->
                        <div class="md:col sm:col-4 col-6 border-left">
                            <figure class="p-2">
                                <a href="#" class="d-block"> <img class="rounded" src="/assets/images/product-tech/4.png"> </a>
                                <div class="px-2 py-3 text-center">
                                    <p class="mb-2"><a href="#" class="text-secondary">The Product name </a></p>
                                    <span class="bg-red-100 text-red px-3 py-1 d-inline-block rounded-full"> -50% </span>
                                </div>
                            </figure>
                        </div> <!-- col.// -->
                        <div class="md:col sm:col-4 col-6 border-left">
                            <figure class="p-2">
                                <a href="#" class="d-block"> <img class="rounded" src="/assets/images/product-tech/5.png"> </a>
                                <div class="px-2 py-3 text-center">
                                    <p class="mb-2"><a href="#" class="text-secondary">The Product name </a></p>
