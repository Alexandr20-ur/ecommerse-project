{
  "name": "Go App with Postgres",
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "golang",
  "workspaceFolder": "/app",
  "customizations": {
    "jetbrains": {
      "settings": {
        "go.formatTool": "goimports"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/go:1": {}
  },
  "onCreateCommand": "go mod download",
  "postCreateCommand": "go install -v golang.org/x/tools/gopls@latest && (go install -v github.com/go-delve/delve/cmd/dlv@latest &)",
  "remoteEnv": {
    "DB_HOST": "postgres",
    "DB_USER": "admin",
    "DB_PASSWORD": "pass",
    "DB_NAME": "master"
  }
}